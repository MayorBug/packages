START=60
STOP=40
USE_PROCD=1

PROG=/usr/sbin/pwm-fan-control
CONFIG=/etc/pwm-fan.conf

start_service()
{
	local modem_enabled=1

	"$PROG" config-upgrade || return 1
	"$PROG" modem-enabled -c "$CONFIG" >/dev/null 2>&1 || modem_enabled=0
	procd_open_instance controller
	procd_set_param command "$PROG" run -c "$CONFIG"
	procd_set_param file "$CONFIG"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	if [ "$modem_enabled" -eq 1 ]; then
		procd_open_instance modem
		procd_set_param command "$PROG" modem-run -c "$CONFIG"
		procd_set_param file "$CONFIG"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

reload_service()
{
	local pid

	pid=$(cat /var/run/pwm-fan-control/daemon.lock/pid 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		procd_send_signal pwm-fan-control '*' HUP
	else
		start_service
	fi
}
